# Copy to .env and fill in from your Supabase project settings (API section).
# Both are publishable client-side values — the anon key is safe in the bundle
# ONLY because every table is protected by row-level security.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Never put a service-role key or any third-party API key in this file.
# Those belong in Supabase Edge Function secrets:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
